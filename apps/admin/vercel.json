{
  "crons": [
    {
      "path": "/api/cron/agents?mode=daily",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/agents?mode=weekly",
      "schedule": "0 2 * * 1"
    },
    {
