# ─── Database (Neon recommended for production) ───────────────────────────────

#

# Neon ↔ Vercel integration (auto-injected):

#   DATABASE_URL            → pooled  (app runtime)

#   DATABASE_URL_UNPOOLED   → direct  (migrations)

#

# Manual local .env:

#   DATABASE_URL            → direct

#   DATABASE_URL_POOLED     → pooled

#

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require



# ─── Auth ─────────────────────────────────────────────────────────────────────

# Random string, at least 32 characters (required in production)

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars



# Vercel Cron + manual cron hits (admin project only)

CRON_SECRET=change-me-to-another-long-random-string



# ─── Google OAuth (seller signup / login) ─────────────────────────────────────

# Create credentials: https://console.cloud.google.com/apis/credentials

# Authorized redirect URIs (add both):

#   http://localhost:3001/api/auth/google/callback

#   https://YOUR-ADMIN-DOMAIN/api/auth/google/callback

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=



# ─── App URLs (set production domains on Vercel) ──────────────────────────────

NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

NEXT_PUBLIC_ROOT_DOMAIN=gumacommerce.ph



# ─── AI (at least one key for live agents; free tier uses Gemini) ─────────────

OPENAI_API_KEY=

GEMINI_API_KEY=

# GOOGLE_AI_API_KEY=   # alias for Gemini

GROQ_API_KEY=



# ─── SMS reminders (Growth+ plans; optional for pre-beta) ────────────────────

SEMAPHORE_API_KEY=



# ─── Payments (optional for checkout pre-beta) ────────────────────────────────

PAYMONGO_SECRET_KEY=

NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=

