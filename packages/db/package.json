{
  "name": "@guma-commerce/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./checkout": "./src/types/tenant-checkout.ts",
    "./shipping": "./src/types/tenant-shipping.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "reconcile": "tsx src/reconcile-migrations.ts",
    "inspect": "tsx src/inspect-db.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "seed:simply-sweet": "tsx src/seed-simply-sweet.ts",
    "test": "tsx --test src/types/tenant-seo.test.ts src/types/tenant-checkout.test.ts src/types/tenant-shipping.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "@guma-commerce/plans": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
